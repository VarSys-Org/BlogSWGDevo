---
// Inline SVG icons. Inline means no extra request and they follow
// `currentColor`, so they work in both themes.
const PATHS = {
	search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
	sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
	moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/>',
	menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
	close: '<path d="M6 6l12 12M18 6 6 18"/>',
	arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
	play: '<path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z" fill="currentColor" stroke="none"/>',
	link: '<path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1"/><path d="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1"/>',
	rss: '<path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14"/><circle cx="6" cy="18" r="1.5" fill="currentColor"/>',
	youtube: '<path d="M22 8.2a3 3 0 0 0-2.1-2.1C18 5.6 12 5.6 12 5.6s-6 0-7.9.5A3 3 0 0 0 2 8.2 31 31 0 0 0 1.6 12 31 31 0 0 0 2 15.8a3 3 0 0 0 2.1 2.1c1.9.5 7.9.5 7.9.5s6 0 7.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .4-3.8 31 31 0 0 0-.4-3.8Z"/><path d="m10 15 5-3-5-3v6Z" fill="currentColor"/>',
	instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>',
	discord: '<path d="M8 7.5a14 14 0 0 1 8 0M7.5 16.5a14 14 0 0 0 9 0"/><path d="M6.2 6.8C4.6 9.2 3.8 12 4 15.2c1.4 1.1 2.9 1.8 4.4 2.3l1-1.6M17.8 6.8c1.6 2.4 2.4 5.2 2.2 8.4-1.4 1.1-2.9 1.8-4.4 2.3l-1-1.6"/><circle cx="9.3" cy="12.3" r="1.2" fill="currentColor"/><circle cx="14.7" cy="12.3" r="1.2" fill="currentColor"/>',
	x: '<path d="M4 4l16 16M20 4 4 20" />',
	whatsapp: '<path d="M4 20l1.3-3.9A8 8 0 1 1 8 19l-4 1Z"/><path d="M9 9.5c.3 2 2.5 4.2 4.5 4.5l1-1 1.5.8"/>',
	reddit: '<circle cx="12" cy="14" r="6.5"/><circle cx="18" cy="6" r="1.5"/><path d="M12 7.5 13 3l5 3"/><circle cx="9.5" cy="13.5" r="1" fill="currentColor"/><circle cx="14.5" cy="13.5" r="1" fill="currentColor"/><path d="M9.5 16.5a4 4 0 0 0 5 0"/>',
} as const;

export type IconName = keyof typeof PATHS;

interface Props {
	name: IconName;
	label?: string;
	class?: string;
}

const { name, label, class: className } = Astro.props;
---

<svg
	class={className}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden={label ? undefined : 'true'}
	role={label ? 'img' : undefined}
	aria-label={label}
	set:html={PATHS[name]}
/>
