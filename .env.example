# Public origin of the site. Used for canonical URLs, Open Graph, sitemap, RSS.
SITE_URL=https://blog.example.com

# Content backend: "file" (JSON in content/, edited by /admin and MCP) or "http" (REST API).
CONTENT_SOURCE=file
# CONTENT_API_URL=https://api.example.com/blog
# CONTENT_API_TOKEN=

# Newsletter sign-up endpoint (POST JSON { email }). Leave empty until ready.
PUBLIC_SIGNUP_URL=

# Admin dashboard at /admin/. Locked until set. Use a long random value.
ADMIN_PASSWORD=
# Optional: signs admin session cookies (defaults to a value derived from the password).
ADMIN_SESSION_SECRET=
# Optional: enables the remote MCP endpoint at /api/mcp/ (send as Bearer token).
BLOG_MCP_KEY=
