---
import PlainPage from '../layouts/PlainPage.astro';
import AuthorBox from '../components/post/AuthorBox.astro';
import { SITE } from '../config/site';
import { getAuthors } from '../lib/content';
import { toUrl } from '../lib/seo/schema';

const authors = await getAuthors();
const site = Astro.site ?? new URL(Astro.url.origin);
const aboutPage = {
	'@type': 'AboutPage',
	name: `About ${SITE.name}`,
	url: toUrl('/about/', site),
	about: { '@id': toUrl('/#organization', site) },
};
---

<PlainPage
	title="About SWG Devo"
	heading="About SWG Devo"
	eyebrow="About"
	description="SWG Devo is a gaming YouTube channel and blog that turns tested settings, tips and reviews into guides you can scroll back to."
	path="/about/"
	schema={[aboutPage]}
>
	<p>
		SWG Devo started as a YouTube channel about competitive shooters and grew into open-world games, mobile gaming and PC hardware. The comments kept asking for the same thing: the settings written down. This blog is the answer.
	</p>
	<h2>What we cover</h2>
	<ul>
		<li><strong>Guides:</strong> best settings, beginner walkthroughs and improvement routines.</li>
		<li><strong>Reviews:</strong> scored reviews with the exact platform and patch we played on.</li>
		<li><strong>Hardware:</strong> PC builds, monitors and performance tuning.</li>
		<li><strong>Mobile:</strong> BGMI and other mobile shooters, tested on mid-range phones.</li>
		<li><strong>Esports:</strong> ranked climbing and how competitive play works.</li>
	</ul>
	<h2>Who writes here</h2>
	{authors.map((author) => <AuthorBox author={author} />)}
	<h2>Find us</h2>
	<ul>
		{
			SITE.social.map((item) => (
				<li>
					<a href={item.url} rel="me noopener" target="_blank">
						{item.label}
					</a>
				</li>
			))
		}
	</ul>
</PlainPage>
