# Public origin of the site. Used for canonical URLs, Open Graph, sitemap, RSS.
SITE_URL=https://blog.example.com

# Content backend: "mock" (built-in sample data) or "http" (REST API).
CONTENT_SOURCE=mock
# CONTENT_API_URL=https://api.example.com/blog
# CONTENT_API_TOKEN=

# Newsletter sign-up endpoint (POST JSON { email }). Leave empty until ready.
PUBLIC_SIGNUP_URL=
