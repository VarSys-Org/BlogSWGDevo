---
import PlainPage from '../layouts/PlainPage.astro';
import AuthorBox from '../components/post/AuthorBox.astro';
import { getAuthors } from '../lib/content';
import { toUrl } from '../lib/seo/schema';

const authors = await getAuthors();
const site = Astro.site ?? new URL(Astro.url.origin);
const aboutPage = {
	'@type': 'AboutPage',
	name: 'About Swagamerz',
	url: toUrl('/about/', site),
	about: { '@id': toUrl('/#organization', site) },
};
---

<PlainPage
	title="About Swagamerz"
	heading="About Swagamerz"
	eyebrow="About"
	description="Swagamerz is a gaming channel and blog with guides, settings walkthroughs, reviews and tips for players."
	path="/about/"
	schema={[aboutPage]}
>
	<p>
		Swagamerz is a gaming channel and blog for players looking for useful guides, settings walkthroughs, reviews and tips across PC, console and mobile games.
	</p>
	<h2>What we cover</h2>
	<ul>
		<li><strong>Guides:</strong> best settings, beginner walkthroughs and improvement routines.</li>
		<li><strong>Reviews:</strong> scored reviews with the exact platform and patch we played on.</li>
		<li><strong>Hardware:</strong> PC builds, monitors and performance tuning.</li>
		<li><strong>Mobile:</strong> BGMI and other mobile shooters, tested on mid-range phones.</li>
		<li><strong>Esports:</strong> ranked climbing and how competitive play works.</li>
	</ul>
	<h2>About the creator</h2>
	{authors.map((author) => <AuthorBox author={author} />)}
</PlainPage>
